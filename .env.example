# Dashboard/server
PORT=3001
HOST=127.0.0.1
AGENT_NAME=network-selfmd-dashboard
L2S_DATA_DIR=/data
# Prefer a mounted 0600 secret file for unattended services.
# L2S_PASSPHRASE_FILE=/run/secrets/networkselfmd-passphrase
# L2S_PASSPHRASE is also supported, but may be exposed by process tooling.

# Required whenever HOST is not a loopback address. Basic auth protects the
# dashboard HTML and every API route except the content-free /healthz probe.
# DASHBOARD_USERNAME=operator
# DASHBOARD_PASSWORD_FILE=/run/secrets/networkselfmd-dashboard-password
# DASHBOARD_PASSWORD is supported for development, but may be exposed by process tooling.

# Optional TTYA PSK, canonical base64 or hex encoding of at least 32 random
# bytes. Prefer the owner-only raw $L2S_DATA_DIR/ttya.psk file in production.
# NETWORKSELFMD_TTYA_PSK=

# For Docker images, keep the image default HOST=0.0.0.0 inside the container,
# and configure dashboard credentials even when binding the published port to
# 127.0.0.1 on the host.
# Do not expose the dashboard directly to the public internet.
# Put it behind VPN, Tailscale, Cloudflare Access, or another auth layer.

# Optional anonymous public site. Operator credentials remain required.
# DASHBOARD_PUBLIC_SITE=true
# NETWORK_PUBLICATION_CONFIG=/run/config/network-publication.json
# Exact browser origin permitted for authenticated operator mutations.
# DASHBOARD_OPERATOR_ORIGIN=https://network.example
